# PostgreSQL connection string. `docker compose up -d db` provides a matching local instance.
DATABASE_URL="postgresql://nivaran:nivaran@localhost:5432/nivaran"

# Optional: separate database used ONLY by `npm test` (tables are truncated between tests!).
# TEST_DATABASE_URL="postgresql://nivaran:nivaran@localhost:5432/nivaran_test"

# Session / JWT signing secret. Generate your own with: openssl rand -base64 32
AUTH_SECRET="replace-this-with-a-long-random-string-in-production"

# Cookie name used for the session token (optional override)
SESSION_COOKIE_NAME="nivaran_session"

# Upload size limit in bytes. Photos are stored in PostgreSQL. On Vercel keep this <= 4000000
# (Vercel caps request bodies at ~4.5MB).
MAX_UPLOAD_BYTES=4000000
