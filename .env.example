# Database (SQLite for local/dev; swap the provider in prisma/schema.prisma for Postgres in production)
DATABASE_URL="file:./dev.db"

# Session / JWT signing secret. Generate your own with: openssl rand -base64 32
AUTH_SECRET="replace-this-with-a-long-random-string-in-production"

# Cookie name used for the session token (optional override)
SESSION_COOKIE_NAME="nivaran_session"

# Max upload size in bytes for attachments (default 5MB)
MAX_UPLOAD_BYTES=5242880

# Local directory for attachment uploads (relative to project root). Files are NOT publicly
# served; they are streamed through /api/uploads/[name] after an access check.
UPLOAD_DIR="uploads"
